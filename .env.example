# Groq API Configuration (Get free ultra-fast API key at https://console.groq.com)
GROQ_API_KEY=

# Swytchcode Configuration
SWYTCHCODE_API_KEY=
SWYTCHCODE_BASE_URL=https://api.swytchcode.com/v1

# Direct API Keys (Optional fallbacks if using direct provider keys)
OPENWEATHER_API_KEY=

# Notion (create integration at https://www.notion.so/my-integrations,
# then connect it to your database and paste the database ID from its URL)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Slack (paste an Incoming Webhook URL, or a Bot User OAuth Token starting with xoxb-)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Resend (create key at https://resend.com/api-keys)
RESEND_API_KEY=

# Where real advisory emails get delivered. Resend's free tier only delivers
# to your own account email until you verify a domain - put that email here.
ALERT_EMAIL_RECIPIENT=

# Server Port
PORT=3001
